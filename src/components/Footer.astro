---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div class="space-y-4">
      <BackToTop />
      <div class="flex items-center gap-3 text-xs text-muted dark:text-muted-dark">
        <svg
          class="block h-4 w-4 text-ink dark:text-paper"
          viewBox="0 0 240 240"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <g fill="currentColor">
            <rect x="36" y="60" width="28" height="120"></rect>
            <rect x="106" y="60" width="28" height="120"></rect>
            <rect x="176" y="96" width="28" height="84"></rect>
            <rect x="36" y="152" width="168" height="28"></rect>
          </g>
          <rect x="176" y="60" width="28" height="28" fill="#ff4d14"></rect>
        </svg>
        <span>&copy; {new Date().getFullYear()} · {SITE.TITLE}</span>
      </div>
    </div>
  </Container>
</footer>
