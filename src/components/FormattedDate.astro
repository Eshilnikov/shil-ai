---
import { getLangFromUrl } from "@i18n/utils";

interface Props {
  date: Date;
}

const { date } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const locale = lang === "ru" ? "ru-RU" : "en-US";
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locale, {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  }
</time>
