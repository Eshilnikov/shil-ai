---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap justify-between gap-y-2">
      <Link href="/" underline={false} aria-label={SITE.TITLE}>
        <svg
          class="block h-7 w-7 text-ink dark:text-paper"
          viewBox="0 0 240 240"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <g fill="currentColor">
            <rect x="36" y="60" width="28" height="120"></rect>
            <rect x="106" y="60" width="28" height="120"></rect>
            <rect x="176" y="96" width="28" height="84"></rect>
            <rect x="36" y="152" width="168" height="28"></rect>
          </g>
          <rect x="176" y="60" width="28" height="28" fill="#ff4d14"></rect>
        </svg>
      </Link>
      <nav class="flex items-center gap-1 text-sm">
        <Link href="/blog">блог</Link>
        <span>
          {`/`}
        </span>
        <Link href="/projects">проекты</Link>
        <button
          id="magnifying-glass"
          aria-label="Поиск"
          class="flex items-center rounded-sm border border-ink/15 bg-paper-soft px-2 py-1 text-xs transition-colors duration-300 ease-in-out hover:bg-ink/5 hover:text-ink focus-visible:bg-ink/5 focus-visible:text-ink dark:border-paper/20 dark:bg-ink-soft dark:hover:bg-paper/5 dark:hover:text-paper dark:focus-visible:bg-paper/5 dark:focus-visible:text-paper"
        >
          <svg
            height="16"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="16"
            style="color: currentcolor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor"></path></svg
          >
          &nbsp;Поиск
        </button>
      </nav>
    </div>
  </Container>
</header>
