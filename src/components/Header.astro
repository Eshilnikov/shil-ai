---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import LangSwitcher from "@components/LangSwitcher.astro";
import { SITE } from "@consts";
import { getLangFromUrl, useTranslations, localizedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap items-center gap-y-2 justify-between">
      <Link href={localizedPath("/", lang)} underline={false}>
        <img src="/logo.svg" alt={SITE.NAME} width="28" height="28" class="h-7 w-7" />
      </Link>
      <div class="flex items-center gap-3">
        <nav class="flex gap-1">
          <Link href={localizedPath("/blog", lang)}>{t("nav.blog")}</Link>
          <span>{`/`}</span>
          <Link href={localizedPath("/projects", lang)}>{t("nav.projects")}</Link>
        </nav>
        <span>{`·`}</span>
        <LangSwitcher />
      </div>
    </div>
  </Container>
</header>
